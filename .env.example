# Copy this file to .env. Never commit .env or real keys.
HELPDESK_BASE_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_API_KEY=
CANDIDATE_EMAIL=

# Example: Groq's hosted API. Obtain your own key; check current account quotas.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Set an exact chat-model ID available to YOUR account; do not assume all are free.
LLM_MODEL=
# Hugging Face alternative (requires credits according to current pricing):
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=<an available model ID from your provider dashboard>

# These are estimates from YOUR provider/model pricing, in USD per million tokens.
# Blank means unknown, not zero. For a genuinely free allocation set both to 0.
INPUT_USD_PER_MILLION=
OUTPUT_USD_PER_MILLION=
# Increase for a provider with a low request/token quota. Retries respect Retry-After.
LLM_MIN_INTERVAL_SECONDS=2
LLM_JSON_MODE=true
